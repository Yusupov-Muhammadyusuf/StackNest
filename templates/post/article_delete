  {% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="{% static 'images/favicon.ico' %}" type="image/x-icon">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{% static 'css/article_delete.css' %}">
    <title>StackNest</title>
</head>
<body>

    <nav>
        <div class="main_items">
            <a href="{% url 'article_list' user.username %}">
                <svg xmlns="http://www.w3.org/2000/svg" width="55" height="55" fill="currentColor" class="bi bi-stack" viewBox="0 0 16 16">
                    <path d="m14.12 10.163 1.715.858c.22.11.22.424 0 .534L8.267 15.34a.6.6 0 0 1-.534 0L.165 11.555a.299.299 0 0 1 0-.534l1.716-.858 5.317 2.659c.505.252 1.1.252 1.604 0l5.317-2.66zM7.733.063a.6.6 0 0 1 .534 0l7.568 3.784a.3.3 0 0 1 0 .535L8.267 8.165a.6.6 0 0 1-.534 0L.165 4.382a.299.299 0 0 1 0-.535z"/>
                    <path d="m14.12 6.576 1.715.858c.22.11.22.424 0 .534l-7.568 3.784a.6.6 0 0 1-.534 0L.165 7.968a.299.299 0 0 1 0-.534l1.716-.858 5.317 2.659c.505.252 1.1.252 1.604 0z"/>
                </svg>
            </a>
        </div>
        <div class="links">
            <ul class="nav_items">
                <li class="nav_item">
                    <span><i class="bi bi-person"></i></span>
                    <a href="{% url 'article_list' user.username %}">Profile</a>
                </li>
                <li class="nav_item">
                    <span><i class="bi bi-info-circle"></i></span>
                    <a href="{% url 'profile' %}">About</a>
                </li>
                <li class="nav_item">
                    <span><i class="bi bi-pencil"></i></span>
                    <a href="{% url 'article_edit' article.pk %}">Edit</a>
                </li>
            </ul>
        </div>
        <div class="search">
            {% if user.is_authenticated %}
                <a href="{% url 'article_new' %}" class="write"><i class="bi bi-pencil-square me-1"></i> Write</a>
            {% else %}
                <a href="{% url 'login' %}" class="write"><i class="bi bi-pencil-square me-1"></i> Write</a>
            {% endif %}

            <div class="nav_wrapper">
                {% if user.profile.image %}
                    <img src="{{ user.profile.image.url }}" alt="UserPhoto" class="nav_photo">
                {% else %}
                    <img src="{% static 'images/user.png' %}" alt="DefaultPhoto" class="nav_photo">
                {% endif %}
            </div>
        </div>
    </nav>

    <div class="card_wrapper">
        <div class="card">
            <h1>Would you really like to delete <span class="title_delete">'{{ object.title }}'</span> article?</h1>
            <form method="post">
                {% csrf_token %}
                <button type="submit" class="delete_button">Delete</button>
                <a href="{% url 'article_detail' article.pk %}">
                    <button type="button" class="cancel_button">Cancel</button>
                </a>
            </form>
            {% if object.photo %}
                <img src="{{ object.photo.url }}" class="article_photo">
            {% else %}
                <img src="{% static 'images/Global.avif' %}" class="article_photo">
            {% endif %}
            <p class="article_body">{{ object.body|safe }}</p>
        </div>
    </div>

    <footer>
        <ul>
            <li class="footer_item"><a href="{% url 'article_list' user.username %}">All posts</a></li>
            <li class="footer_item"><a href="{% url 'about' %}">About</a></li>
            <li class="footer_item"><a href="#">Rules</a></li>
        </ul>
    </footer>
    
</body>
</html>
